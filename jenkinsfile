pipeline {
    agent any
    
    environment {
        // Define environment variables
        DOCKER_IMAGE = 'spinny-web-automation' // Name of the Docker image
        CONTAINER_ID = '' // Variable to store the container ID
    }

    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    // Build the Docker image
                    docker.build(env.DOCKER_IMAGE, '.')
                }
            }
        }

        stage('Run Tests') {
            steps {
                script {
                    // Run the Docker container
                    CONTAINER_ID = sh(script: "docker run -d ${env.DOCKER_IMAGE}", returnStdout: true).trim()
                }
            }
        }

        stage('Execute Tests') {
            steps {
                script {
                    // Run tests inside the Docker container
                    docker.image(env.DOCKER_IMAGE).inside(CONTAINER_ID) {
                        sh 'mvn clean test'
                    }
                }
            }
        }

        stage('Publish Cucumber Reports') {
            steps {
                script {
                    // Copy Cucumber reports from Docker container to Jenkins workspace
                    sh "docker cp $CONTAINER_ID:/usr/src/app/target/cucumber-html-reports ./cucumber-reports"
                }
                // Publish HTML Cucumber reports in Jenkins
                publishHTML(
                    target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: false,
                        keepAll: false,
                        reportDir: 'cucumber-reports',
                        reportFiles: 'overview-features.html',
                        reportName: 'HTML Cucumber Report',
                        reportTitles: ''
                    ]
                )
            }
        }

        stage('Cleanup') {
            steps {
                // Clean up - stop and remove the Docker container
                script {
                    sh "docker stop $CONTAINER_ID"
                    sh "docker rm $CONTAINER_ID"
                }
            }
        }
    }
}
