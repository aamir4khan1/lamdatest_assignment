pipeline {
    agent {label 'codebuild'}
    
    environment {
        DOCKER_IMAGE = 'spinny-web-automation'
        CONTAINER_ID = ''
    }

    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    docker.build(env.DOCKER_IMAGE, '.')
                }
            }
        }

        stage('Run Tests in Headless Mode') {
            steps {
                script {
                    try {
                        CONTAINER_ID = sh(script: "docker run -d ${env.DOCKER_IMAGE}", returnStdout: true).trim()
                        sh "docker exec $CONTAINER_ID mvn clean test"
                        sh "docker cp $CONTAINER_ID:/usr/SpinnyWebAutomation/target/cucumber-html-reports ./automation-reports"
                    } finally {
                        // Add cleanup steps in case of any errors
                        sh "docker stop $CONTAINER_ID"
                        sh "docker rm $CONTAINER_ID"
                    }
                }
            }
        }
    }
    
    post {
        always {
            // Publish HTML report regardless of previous stage outcomes
            script {
                publishHTML(
                    target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: false,
                        reportDir: 'automation-reports',
                        reportFiles: 'overview-features.html',
                        reportName: 'HTML Cucumber Report',
                        reportTitles: ''
                    ]
                )
            }
        }
        
        failure {
            echo "Pipeline failed. Cleaning up..."
            sh "docker stop $CONTAINER_ID"
            sh "docker rm $CONTAINER_ID"
        }
    }
}
