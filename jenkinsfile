pipeline {
    agent {label 'codebuild'}
    
    environment {
        DOCKER_IMAGE = 'spinny-web-automation'
        CONTAINER_ID = ''
        SLACK_CHANNEL = '#automation_suite_result'
    }

    stages {
        stage('Build Docker Image') {
            steps {
                script {
                    docker.build(env.DOCKER_IMAGE, '.')
                }
            }
        }

        stage('Run Tests in Headless Mode') {
            steps {
                script {
                    
                        CONTAINER_ID = sh(script: "docker run -d ${env.DOCKER_IMAGE}", returnStdout: true).trim()
                        sh "docker exec $CONTAINER_ID mvn clean test"
                        
                }
            }
        }
    }
    
    post {
        always {
            // Ensure HTML report directory exists
           script {
             //  sh "mkdir -p automation-reports"
                        //sh "ls -l automation-reports"
                        sh "docker cp $CONTAINER_ID:/usr/SpinnyWebAutomation/target/cucumber-html-reports ./automation-reports"
                         //sh "apt update && apt install -y zip"
                        //sh "zip -r automation-reports.zip automation-reports"
                    //sh "ls -l automation-reports"
         }
            // Debug: List files in cucumber-reports directory
         // script {
               // sh "ls -l cucumber-reports"
          // }
          // script {
              //  slackSend(
                 //   channel: env.SLACK_CHANNEL,
                   // message: "Cucumber reports zip file",
                  //  file: "automation-reports.zip"
               // )
           // }
            // Publish HTML report regardless of previous stage outcomes
            script {
                publishHTML(
                    target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: true,
                        keepAll: false,
                        reportDir: 'automation-reports',
                        reportFiles: 'overview-features.html',
                        reportName: 'HTML Cucumber Report',
                        reportTitles: ''
                    ]
                )
            }
            // Debug: Print the content of the cucumber-reports directory
          // script {
          //     sh "cat cucumber-reports/*"
           // }
            // Cleanup Docker container
            script {
                sh "docker stop $CONTAINER_ID"
                sh "docker rm $CONTAINER_ID"
            }
        }
        
        failure {
            echo "Pipeline failed. Cleaning up..."
            sh "docker stop $CONTAINER_ID"
            sh "docker rm $CONTAINER_ID"
        }
    }
}
