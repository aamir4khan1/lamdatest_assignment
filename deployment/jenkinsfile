pipeline {
    agent any
    stages {
        stage('Test') {
            steps {
                script {
                    sh "docker build -t consumer-web-automation:v1 -f Dockerfile ."
                    // below the line to create container name
                    sh "docker create --name auto-test-result consumer-web-automation:v1 
                    // create directory to paste result build from container 
                    sh "mkdir automation-reports"
                    // copy paste test result to dir in Jenkins
                    sh "docker cp auto-test-result:/usr/app/target/cucumber-html-reports/overview-features.html automation-reports/overview-features.html"
                }
            }
            post {
                // If Maven was able to run the tests, even if some of the test
                // failed, record the test results and publish HTML file.
                success {
                    publishHTML([
                        allowMissing: false, 
                        alwaysLinkToLastBuild: false, 
                        keepAll: false, 
                        reportDir: 'automation-reports', 
                        reportFiles: 'overview-features.html', 
                        reportName: 'HTML Report', 
                        reportTitles: '', 
                        useWrapperFileDirectly: true
                    ])
                }
            }
        }
        stage('clean after build'){
            steps{
                script{
                    println 'Done for test automation'
                    cleanWs()
                }
            }
        }
    }
}