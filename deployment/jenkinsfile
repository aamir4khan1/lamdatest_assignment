pipeline {
    agent any

    environment {
        // Define an environment variable to store the container ID
        CONTAINER_ID = ''
    }

    stages {
        stage('Build and Test') {
            steps {
                script {
                    // Build the Docker image
                    docker.build('SpinnyWebAutomation', 'deployment/')

                    // Run the Docker container and capture the container ID
                    CONTAINER_ID = sh(script: 'docker run -d SpinnyWebAutomation', returnStdout: true).trim()
                }
            }
        }

        stage('Run Tests') {
            steps {
                // Run tests inside the Docker container
                script {
                    docker.image('SpinnyWebAutomation').inside(CONTAINER_ID) {
                        // Run Maven command to execute tests
                        sh 'mvn clean test'
                    }
                }
            }
        }

        stage('Publish Cucumber Reports') {
            steps {
                // Copy Cucumber reports from Docker container to Jenkins workspace
                script {
                    sh "docker cp $CONTAINER_ID:/usr/src/app/target/cucumber-html-reports ./cucumber-reports"
                }
                // Publish HTML Cucumber reports in Jenkins
                publishHTML(
                    target: [
                        allowMissing: false,
                        alwaysLinkToLastBuild: false,
                        keepAll: false,
                        reportDir: 'cucumber-reports',
                        reportFiles: 'overview-features.html',
                        reportName: 'HTML Cucumber Report',
                        reportTitles: ''
                    ]
                )
            }
        }
    }
}
