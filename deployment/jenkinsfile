pipeline {
    agent any
    stages {
        stage('Test') {
            steps {
                script {
                    sh "docker build -t spinny-web-automation:v1 -f deployment/Dockerfile ."
                    // below the line to create container name
                    sh "docker create --name spinny5-test-result spinny-web-automation:v1" 
                    // create directory to paste result build from container 
                    sh "mkdir spinnyautomation1-reports"
                    // copy paste test result to dir in Jenkins
                    sh "docker cp spinny5-test-result:/usr/app/target/cucumber-html-reports/overview-features.html spinnyautomation1-reports/overview-features.html"
                }
            }
           post {
                // If Maven was able to run the tests, even if some of the test
                // failed, record the test results and publish HTML file.
              success {
                    publishHTML([
                        allowMissing: false, 
                        alwaysLinkToLastBuild: false, 
                        keepAll: false, 
                        reportDir: 'spinnyautomation1-reports', 
                        reportFiles: 'overview-features.html', 
                        reportName: 'HTML Report', 
                        reportTitles: ''
                        
                   ])
                }
           }
       }
        stage('clean after build'){
            steps{
                script{
                    println 'Done for test automation'
                    cleanWs()
                }
            }
        }
    }
}
